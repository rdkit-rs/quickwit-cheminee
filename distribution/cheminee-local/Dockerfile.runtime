FROM ubuntu@sha256:f144425ff09be612d6d9ad965196e9cdc23dae1f42110a8a11a3e9a8198759f7
COPY root/ /
COPY manifest.json /opt/cheminee-runtime-manifest.json
RUN mkdir -p /var/lib/cheminee && chown 10001:10001 /var/lib/cheminee
USER 10001:10001
ENV QW_DISABLE_TELEMETRY=1
ENTRYPOINT ["/usr/local/bin/quickwit"]
