FROM ubuntu@sha256:f144425ff09be612d6d9ad965196e9cdc23dae1f42110a8a11a3e9a8198759f7
ARG CHEMINEE_VERSION
ARG SOURCE_COMMIT
LABEL org.opencontainers.image.title="Cheminee" \
      org.opencontainers.image.description="Private Cheminee pilot candidate using the Quickwit engine" \
      org.opencontainers.image.version="${CHEMINEE_VERSION}" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      org.opencontainers.image.base.name="ubuntu@sha256:f144425ff09be612d6d9ad965196e9cdc23dae1f42110a8a11a3e9a8198759f7" \
      io.cheminee.publication-authorized="false"
COPY root/ /
COPY manifest.json /opt/cheminee-runtime-manifest.json
RUN mkdir -p /var/lib/cheminee && chown 10001:10001 /var/lib/cheminee
USER 10001:10001
ENV QW_DISABLE_TELEMETRY=1 \
    QW_CHEMINEE_MODEL_ASSETS=/opt/cheminee-model/assets \
    LD_LIBRARY_PATH=/opt/cheminee-tensorflow/lib
ENTRYPOINT ["/usr/local/bin/quickwit"]
